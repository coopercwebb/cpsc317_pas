    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: clang build and lldb debug active file",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "Build", 
            "program": "${workspaceFolder}/sender", // path to your programs exe and exe name
            "args": ["smallfile"], 
            "cwd": "${workspaceFolder}",
            "postDebugTask": "Post-Debug Cleanup"
        },
        {
            "name": "No preLaunchTask",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/sender", // path to your programs exe and exe name
            "args": ["smallfile"], 
            "cwd": "${workspaceFolder}",
            "postDebugTask": "Post-Debug Cleanup" // pkill receiver && pkill sender && diff smallfile OutputFile
        },
    ]
}


